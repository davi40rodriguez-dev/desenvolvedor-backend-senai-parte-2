@page "/"
@using ProjetoWeb01.Components.Pages.Parciais
<!-- Isso é comentário em html-->
<PageTitle>HOME</PageTitle>
<CabecalhoPagina/>
<main class="corpo-pagina">
    <div class="login-container">
        <div class="login-cabecalho">
            <h1 class="login-titular">Acesso ao WIFI</h1>
            <p class="login-subtitulo"> Sistema de gestão WIFI</p>
        </div>
        <form class="login-form">
            <!-- Aviso: Implementar validação de campos -->
            <div class="form-grupo">
                <label class="form-label">E-mail institucional</label>
                <div class="input-w">
                    <input type="email" id="email" class="form-input"
                    placeholder="user@Dispatcher.senai.br "/>
                <div>
              </div>
              <div class="form-grupo">
                  <label>Senha</label>
                  <div class="input-w">
                      <input type="password" id="senha" class="form-input" placeholder="*******"/>

                     </div>
                   </div>
                   <button>
                   Entrar
                   </button>
                </div>
            </div>
        </form>
    </div>
</main>

<Rodape/>
